# Google Cloud OAuth 2.0 Web application credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Uncomment to allow access from other computers on the local network.
# HOST=0.0.0.0

# Use this exact authorized redirect URI in Google Cloud for the default port.
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3001/api/drive/callback

# Daily backup time in the server machine's local timezone.
DRIVE_BACKUP_TIME=23:00
